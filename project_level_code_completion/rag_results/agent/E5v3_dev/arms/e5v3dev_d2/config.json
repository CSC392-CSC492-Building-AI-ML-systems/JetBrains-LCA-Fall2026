{
    "params": {
        "preprocess_params": {
            "model": "huggingface",
            "composers": "none",
            "tokenizer": "codellama/CodeLlama-7b-hf"
        },
        "inference_params": {
            "model": "codellama-7b",
            "seq_max_len": 16000,
            "input_data_path": "",
            "context_max": -1
        },
        "eval_params": {
            "device": "cuda"
        }
    },
    "composers_config": {
        "lang_sep_symbol": "",
        "meta_info_sep_symbol": "METASEP\n",
        "extension": ""
    },
    "dataset": {
        "path": "JetBrains-Research/lca-project-level-code-completion",
        "name": "medium_context"
    },
    "rag": {
        "prefix_cap": 15900,
        "query_lines": 10,
        "max_chunks": 30,
        "include_non_py": true,
        "max_context_tokens": null,
        "proximity_weight": 0.0,
        "import_weight": 0.0,
        "definitions_first": false,
        "definition_chunks": 8,
        "definition_tokens": 2000,
        "definition_imports": true,
        "order": "best_last",
        "continuation_lines": 20,
        "chunking": "structure",
        "fine_window": 10,
        "fine_stride": 5,
        "retriever": "bm25",
        "query_mode": "last",
        "embedder": null,
        "pooling": "cls",
        "embedding_cache": "~/lca_artifacts/embeddings"
    },
    "agent": {
        "planner_model": "Qwen/Qwen2.5-Coder-32B-Instruct",
        "planner_dtype": "4bit",
        "planner_max_new_tokens": 200,
        "planner_prefix_tokens": 1500,
        "max_listed_files": 100,
        "limits": {
            "tool_calls": 5,
            "search_results": 5,
            "read_lines": 80,
            "tool_output_tokens": 1200,
            "seed_chunk_tokens": 300,
            "definition_lines": 25,
            "query_characters": 300,
            "max_items": 8,
            "invalid_actions": 2,
            "edit_mode": "append",
            "max_add": 2,
            "max_evict": 2
        }
    },
    "language": "python",
    "artifacts_dir": "/root/lca_artifacts",
    "seed": 42,
    "arm": "agent",
    "arm_name": "e5v3dev_d2",
    "limit_datapoints": null,
    "split": "dev",
    "dev_size": 8,
    "dev_extra": 16,
    "shard_index": null,
    "shard_count": null,
    "lines": "all",
    "static_mode": "provider",
    "context_cap": 1753,
    "run_zero": false,
    "overwrite": false,
    "resume": true
}