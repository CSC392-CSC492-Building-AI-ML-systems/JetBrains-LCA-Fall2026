{
    "params": {
        "preprocess_params": {
            "model": "huggingface",
            "composers": "none",
            "tokenizer": "bigcode/starcoderbase-1b"
        },
        "inference_params": {
            "model": "starcoderbase-1b",
            "seq_max_len": 8000,
            "input_data_path": "",
            "context_max": -1
        },
        "eval_params": {
            "device": "cuda"
        }
    },
    "composers_config": {
        "lang_sep_symbol": "",
        "meta_info_sep_symbol": "METASEP\n",
        "extension": ""
    },
    "dataset": {
        "path": "JetBrains-Research/lca-project-level-code-completion",
        "name": "small_context"
    },
    "rag": {
        "prefix_cap": 4000,
        "query_lines": 10,
        "max_chunks": 30,
        "include_non_py": true,
        "max_context_tokens": null,
        "proximity_weight": 0.0,
        "import_weight": 0.0,
        "definitions_first": false,
        "definition_chunks": 8,
        "definition_tokens": 2000,
        "definition_imports": true,
        "order": "best_last",
        "continuation_lines": 0,
        "chunking": "structure",
        "fine_window": 10,
        "fine_stride": 5,
        "retriever": "bm25",
        "query_mode": "last",
        "embedder": null,
        "pooling": "cls",
        "embedding_cache": "~/lca_artifacts/embeddings"
    },
    "language": "python",
    "artifacts_dir": "/home/adriana/lca_artifacts",
    "seed": 42,
    "arm": "function_class_mask_half",
    "arm_name": "hall_small_function_class_mask_half",
    "limit_datapoints": null,
    "split": "heldout",
    "dev_size": 20,
    "dev_extra": 28,
    "lines": "all",
    "static_mode": "provider",
    "run_zero": false,
    "overwrite": true
}